{
  "name": "craftui",
  "version": "0.1.0",
  "description": "CraftUI CLI — add production-ready components to your project",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "craftui": "dist/index.js"
  },
  "files": ["dist", "templates"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@craftui/registry": "workspace:*",
    "@craftui/ui": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "cosmiconfig": "^9.0.0",
    "diff": "^5.2.0",
    "execa": "^8.0.1",
    "fs-extra": "^11.2.0",
    "inquirer": "^9.2.18",
    "ora": "^8.0.1"
  },
  "devDependencies": {
    "@craftui/config": "workspace:*",
    "@types/diff": "^5.2.0",
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.11.30",
    "tsup": "^8.0.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["cli", "craftui", "ui", "components", "react", "tailwind"]
}
